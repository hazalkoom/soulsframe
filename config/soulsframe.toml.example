# SoulsFrame configuration
# Copy next to DarkSoulsIII.exe / dinput8.dll as "soulsframe.toml".

[general]
# REQUIRED: SoulsFrame is offline-only. Using DLL hooks online risks account bans.
# Set to true to confirm you are launching Dark Souls III offline.
offline_acknowledged = false
mod_enabled = true
log_level = "info"

[present]
# "game" = leave swap chain as DS3 creates it; "flip" = M5 FLIP_DISCARD upgrade (windowed, non-MSAA)
mode = "game"
max_fps = 0

[modules]
frame_telemetry = true
presentation = false
probe_tracer = false
particles = false
upscaler = false

[particles]
# M6 particle overdraw mitigation: "auto", "throttle", or "half_res"
mode = "auto"
scale_percent = 50
max_instances_per_draw = 0
max_draws_per_frame = 0

[upscaler]
# M7 spatial upscaler & RCAS sharpener: "none", "bilinear", "fsr1", or "rcas_only"
mode = "fsr1"
# Preset: "native" (100%), "ultra_quality" (77%), "quality" (67%), "balanced" (59%), "performance" (50%), or "custom"
preset = "ultra_quality"
scale_percent = 77
sharpness_percent = 80

[probe]
# Only used in SF_PROBE builds when modules.probe_tracer = true.
capture_frames = 120
output_file = "soulsframe_capture.jsonl"
trace_resources = true
# Measure GPU time per pass using D3D11 timestamp queries (adds gpu_ms to the capture).
gpu_timing = true
# Dump a read-only, Ghidra-aligned memory copy of the host executable once at startup (M4 RE).
dump_module = false
dump_file = "soulsframe_mem_dump.exe"
