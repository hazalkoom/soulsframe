# SoulsFrame configuration
# Copy next to DarkSoulsIII.exe / dinput8.dll as "soulsframe.toml".

[general]
# REQUIRED: SoulsFrame is offline-only. Using DLL hooks online risks account bans.
# Set to true to confirm you are launching Dark Souls III offline.
offline_acknowledged = false
mod_enabled = true
log_level = "info"

[present]
# "game" = leave swap chain as DS3 creates it; "flip" = M5 FLIP_DISCARD upgrade (windowed, non-MSAA)
mode = "game"
max_fps = 0

[modules]
frame_telemetry = true
presentation = false
probe_tracer = false
particles = false
upscaler = false
fps_unlock = false
textures = false
overlay = false

[particles]
# M6 particle overdraw mitigation: "auto", "throttle", or "half_res"
mode = "auto"
scale_percent = 50
max_instances_per_draw = 0
max_draws_per_frame = 0

[upscaler]
# M7 spatial upscaler & RCAS sharpener: "none", "bilinear", "fsr1", or "rcas_only"
mode = "fsr1"
# Preset: "native" (100%), "ultra_quality" (77%), "quality" (67%), "balanced" (59%), "performance" (50%), or "custom"
preset = "ultra_quality"
scale_percent = 77
sharpness_percent = 80

[fps_unlock]
# M8 experimental FPS unlock research: "fixed_step", "camera_only", or "variable_dt"
strategy = "fixed_step"
target_fps = 120
sim_tick_hz = 60
max_substeps = 4

[textures]
# M9 offline texture packs: folder next to dinput8.dll with manifest.txt + DDS files
pack_dir = "soulsframe_textures"
max_pack_mb = 512
# Log keys of loaded textures so packs can be authored with tools/py/bake_textures.py
dump_keys = false

[overlay]
# In-game FPS viewer & hotkey status HUD (requires modules.overlay = true)
show_fps = true
show_status = true
# Corner: "top_left", "top_right", "bottom_left", or "bottom_right"
position = "top_left"
scale = 2
opacity_percent = 75

[hotkeys]
# Live toggles (F1-F12, Insert, Delete, Home, End, PageUp, PageDown, Pause, ScrollLock, Numpad0-9, or "none")
enabled = true
toggle_overlay = "F9"
toggle_mod = "F10"
toggle_upscaler = "F11"
toggle_particles = "F8"
toggle_frame_cap = "F12"

[probe]
# Only used in SF_PROBE builds when modules.probe_tracer = true.
capture_frames = 120
output_file = "soulsframe_capture.jsonl"
trace_resources = true
# Measure GPU time per pass using D3D11 timestamp queries (adds gpu_ms to the capture).
gpu_timing = true
# Dump a read-only, Ghidra-aligned memory copy of the host executable once at startup (M4 RE).
dump_module = false
dump_file = "soulsframe_mem_dump.exe"
